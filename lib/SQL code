-- Drop all tables in the correct order to avoid dependency issues
DROP TABLE IF EXISTS conversation_participants cascade;
DROP TABLE IF EXISTS workshop_requests cascade;
DROP TABLE IF EXISTS messages cascade;
DROP TABLE IF EXISTS conversations cascade;
DROP TABLE IF EXISTS workshop_enrollments cascade;
DROP TABLE IF EXISTS workshop_ratings cascade;
DROP TABLE IF EXISTS workshops cascade;
DROP TABLE IF EXISTS endorsements cascade;
DROP TABLE IF EXISTS achievements cascade;
DROP TABLE IF EXISTS leaderboard cascade;
DROP TABLE IF EXISTS cv_entries cascade;
DROP TABLE IF EXISTS follows cascade;
DROP TABLE IF EXISTS skills cascade;
DROP TABLE IF EXISTS users cascade;

-- Create the users table
CREATE TABLE users (
  id uuid primary key,                     -- Supabase Auth user ID
  email text unique not null,
  name text,
  phone text,
  bio text,
  university text,
  major text,
  year text,
  location text,
  website text,
  avatar_url text,                         -- Renamed column for avatar_url
  skills_to_teach text[],                  -- Skills to teach
  skills_to_learn text[],                  -- Skills to learn
  social jsonb default '{}'::jsonb,        -- Social media info (json)
  created_at timestamp with time zone default now()       -- Created at timestamp
);

-- Create the skills table
CREATE TABLE skills (
  id uuid primary key default uuid_generate_v4(),
  name text unique not null
);

-- Create the follows table to track follower relationships
CREATE TABLE follows (
  id uuid primary key default uuid_generate_v4(),
  follower_id uuid references users(id) on delete cascade, -- The user who is following
  following_id uuid references users(id) on delete cascade, -- The user being followed
  created_at timestamp with time zone default now(),
  unique(follower_id, following_id) -- A user can't follow the same person twice
);

-- Create the workshops table
CREATE TABLE workshops (
  id uuid primary key default uuid_generate_v4(),
  creator_id uuid references users(id) on delete cascade,
  title text not null,
  description text,
  category text,
  duration text,
  date timestamp with time zone, -- Changed to timestamp with time zone to store date and time
  max_participants int,
  skills text[],                           -- Skills required for the workshop
  image_url text,                          -- Image URL for the workshop
  created_at timestamp with time zone default now(), -- Changed to timestamp with time zone

  -- New columns added for your app's functionality
  type text DEFAULT 'Free Workshop', -- 'Free Workshop' or 'Teach4Learn'
  skill_requested text, -- For Teach4Learn type
  skill_offered text,   -- For Teach4Learn type
  difficulty text DEFAULT 'Beginner',
  time text, -- e.g., '10:00 AM'
  location text,
  status text DEFAULT 'upcoming', -- e.g., 'upcoming', 'completed', 'cancelled'
  rating float DEFAULT 0.0,
  syllabus jsonb DEFAULT '[]'::jsonb,
  prerequisites text[] DEFAULT '{}',
  outcomes text[] DEFAULT '{}',
  tags text[] DEFAULT '{}'
);

-- Create the workshop enrollments table
CREATE TABLE workshop_enrollments (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references users(id) on delete cascade,
  workshop_id uuid references workshops(id) on delete cascade,
  status text default 'enrolled',
  enrolled_at timestamp with time zone default now(),
  unique(user_id, workshop_id)
);

-- Create the workshop ratings table
CREATE TABLE workshop_ratings (
  id uuid primary key default uuid_generate_v4(),
  workshop_id uuid references workshops(id) on delete cascade,
  user_id uuid references users(id) on delete cascade,
  rating int check(rating >= 1 and rating <= 5),
  review text,
  created_at timestamp with time zone default now(),
  unique(user_id, workshop_id)
);

-- Create the endorsements table
CREATE TABLE endorsements (
  id uuid primary key default uuid_generate_v4(),
  endorsed_user uuid references users(id),
  endorsed_by uuid references users(id),
  skill text,
  created_at timestamp with time zone default now()
);

-- Create the achievements table
CREATE TABLE achievements (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references users(id) on delete cascade,
  name text,
  icon text,
  earned boolean default false,
  created_at timestamp with time zone default now()
);

-- Create the leaderboard table
CREATE TABLE leaderboard (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references users(id) on delete cascade,
  xp int default 0,
  level int default 1,
  updated_at timestamp with time zone default now()
);

-- Create the CV entries table
CREATE TABLE cv_entries (
  id uuid primary key default uuid_generate_v4(),
  user_id uuid references users(id),
  title text,
  description text,
  start_date date,
  end_date date,
  type text,
  created_at timestamp with time zone default now()
);

-- Create the workshop_requests table
CREATE TABLE workshop_requests (
  id uuid primary key default uuid_generate_v4(),
  workshop_id uuid references workshops(id) on delete cascade,
  requester_id uuid references users(id) on delete cascade,
  status text default 'pending', -- 'pending', 'accepted', 'declined'
  message text, -- Optional message from requester
  created_at timestamp with time zone default now(),
  updated_at timestamp with time zone default now(),
  unique(workshop_id, requester_id)
);

-- Create the 'conversations' table WITHOUT the foreign key to 'messages'
CREATE TABLE conversations (
  id uuid primary key default uuid_generate_v4(),
  created_at timestamp with time zone default now(),
  updated_at timestamp with time zone default now(),
  -- last_message_id will be added later
  is_group boolean default false,
  name text, -- For group chats
  avatar_url text, -- For group chats
  created_by uuid references users(id) on delete cascade
);

-- Create the 'messages' table
CREATE TABLE messages (
  id uuid primary key default uuid_generate_v4(),
  conversation_id uuid references conversations(id) on delete cascade,
  sender_id uuid references users(id) on delete cascade,
  content text,
  created_at timestamp with time zone default now(),
  updated_at timestamp with time zone default now(),
  read_at timestamp with time zone,
  message_type text default 'text' -- 'text', 'image', 'file', etc.
);

-- Create 'conversation_participants' table
CREATE TABLE conversation_participants (
  id uuid primary key default uuid_generate_v4(),
  conversation_id uuid references conversations(id) on delete cascade,
  user_id uuid references users(id) on delete cascade,
  joined_at timestamp with time zone default now(),
  last_read_at timestamp with time zone,
  is_admin boolean default false, -- For group chats
  unique(conversation_id, user_id)
);

-- NOW, add the 'last_message_id' column to 'conversations' and create the foreign key
