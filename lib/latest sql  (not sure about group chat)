-- 10. Create a Postgres Function to get all user gamification data in one go
-- This is much more efficient than making multiple separate calls from the app.
CREATE OR REPLACE FUNCTION get_user_gamification_data(current_user_id UUID)
RETURNS TABLE(
  -- User stats
  user_xp INT,
  user_level INT,
  workshops_attended BIGINT,
  workshops_taught BIGINT,
  badges_earned BIGINT,
  endorsements_count BIGINT,
  -- Leaderboard
  leaderboard JSONB,
  -- Badges
  user_badges_data JSONB,
  -- Achievements
  user_achievements_data JSONB
) LANGUAGE sql STABLE SECURITY DEFINER AS $$   SELECT
    -- User Stats
    u.xp,
    u.level,
    (SELECT count(*) FROM workshop_enrollments WHERE user_id = current_user_id),
    (SELECT count(*) FROM workshops WHERE creator_id = current_user_id),
    (SELECT count(*) FROM user_badges WHERE user_id = current_user_id AND earned = true),
    (SELECT count(*) FROM endorsements WHERE endorsed_user = current_user_id),

    -- Leaderboard (Top 20 + current user)
    (SELECT jsonb_agg(row_to_json(lb))
     FROM (
       SELECT
         row_number() OVER (ORDER BY xp DESC) AS rank,
         id,
         name,
         avatar_url,
         xp,
         (SELECT count(*) FROM user_badges WHERE user_id = u.id AND earned = true) AS badges
       FROM users u
       ORDER BY xp DESC
       LIMIT 20
     ) AS lb
    ),

    -- User Badges (merged with definitions)
    (SELECT jsonb_agg(row_to_json(badge_data))
     FROM (
       SELECT
         bd.id,
         bd.name,
         bd.description,
         bd.icon,
         bd.rarity,
         COALESCE(ub.earned, false) AS earned,
         COALESCE(ub.progress, 0) AS progress,
         bd.requirement_value AS max
       FROM badge_definitions bd
       LEFT JOIN user_badges ub ON bd.id = ub.badge_id AND ub.user_id = current_user_id
     ) AS badge_data
    ),

    -- User Achievements (merged with definitions)
    (SELECT jsonb_agg(row_to_json(ach_data))
     FROM (
       SELECT
         ad.id,
         ad.title,
         ad.description,
         ad.icon,
         ad.reward_value AS reward,
         COALESCE(ua.progress, 0) AS progress,
         ad.requirement_value AS max
       FROM achievement_definitions ad
       LEFT JOIN user_achievements ua ON ad.id = ua.achievement_id AND ua.user_id = current_user_id
     ) AS ach_data
    )

  FROM users u WHERE u.id = current_user_id;
 $$;

