-- Add this function to your database schema
CREATE OR REPLACE FUNCTION check_workshop_completion(
  p_user_id UUID,
  p_workshop_id UUID
)
RETURNS BOOLEAN
LANGUAGE plpgsql
SECURITY DEFINER
AS $$ DECLARE
  total_lessons INT;
  completed_lessons INT;
  is_enrolled BOOLEAN;
BEGIN
  -- Check if the user is enrolled in the workshop
  SELECT EXISTS(SELECT 1 FROM workshop_enrollments WHERE user_id = p_user_id AND workshop_id = p_workshop_id) INTO is_enrolled;

  IF NOT is_enrolled THEN
    RETURN FALSE;
  END IF;

  -- Get workshop details for completion check
  SELECT jsonb_array_length(syllabus) INTO total_lessons
  FROM workshops
  WHERE id = p_workshop_id;

  -- Get the number of completed lessons for the user
  SELECT COUNT(*) INTO completed_lessons
  FROM user_syllabus_progress
  WHERE user_id = p_user_id AND workshop_id = p_workshop_id;

  -- Check if all lessons are completed
  IF total_lessons IS NOT NULL AND completed_lessons >= total_lessons THEN
    -- Mark the workshop as completed in the enrollments table if not already marked
    UPDATE workshop_enrollments
    SET status = 'completed', completed_at = NOW()
    WHERE user_id = p_user_id AND workshop_id = p_workshop_id AND status != 'completed';

    -- Award XP and check for completion badges
    PERFORM award_xp_and_check_badges(p_user_id, 50, 'workshop_completed', p_workshop_id);

    RETURN TRUE;
  END IF;

  RETURN FALSE;
END;
 $$;










