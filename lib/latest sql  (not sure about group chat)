-- FIX #1: Allow users to create conversations
-- The key fix: No ::uuid cast needed - auth.uid() already returns UUID
CREATE POLICY "Users can create conversations"
ON conversations FOR INSERT
WITH CHECK (
  created_by = auth.uid()
);

-- FIX #2: Allow users to view their conversations
CREATE POLICY "Users can view their conversations"
ON conversations FOR SELECT
USING (
  EXISTS (
    SELECT 1 FROM conversation_participants cp
    WHERE cp.conversation_id = conversations.id
    AND cp.user_id = auth.uid()
  )
);

-- FIX #3: Allow participants to update conversation metadata
CREATE POLICY "Participants can update conversation metadata"
ON conversations FOR UPDATE
USING (
  EXISTS (
    SELECT 1 FROM conversation_participants cp
    WHERE cp.conversation_id = conversations.id
    AND cp.user_id = auth.uid()
  )
);

-- ============================================================
-- CONVERSATION PARTICIPANTS POLICIES
-- ============================================================

CREATE POLICY "Users can view participants in their conversations"
ON conversation_participants FOR SELECT
USING (
  user_id = auth.uid()
  OR EXISTS (
    SELECT 1 FROM conversation_participants cp
    WHERE cp.conversation_id = conversation_participants.conversation_id
    AND cp.user_id = auth.uid()
  )
);

CREATE POLICY "Allow inserting participants"
ON conversation_participants FOR INSERT
WITH CHECK (
  -- You can always add yourself
  user_id = auth.uid()

  -- OR you can add others if you're already a participant
  OR EXISTS (
    SELECT 1 FROM conversation_participants cp
    WHERE cp.conversation_id = conversation_participants.conversation_id
    AND cp.user_id = auth.uid()
  )

  -- OR you can add the second person right after creating the conversation
  OR EXISTS (
    SELECT 1 FROM conversations c
    WHERE c.id = conversation_participants.conversation_id
    AND c.created_by = auth.uid()
  )

  -- OR workshop creator can add people
  OR EXISTS (
    SELECT 1 FROM workshops w
    WHERE w.conversation_id = conversation_participants.conversation_id
    AND w.creator_id = auth.uid()
  )

  -- OR auto-add via enrollment
  OR EXISTS (
    SELECT 1 FROM workshop_enrollments we
    JOIN workshops w ON we.workshop_id = w.id
    WHERE w.conversation_id = conversation_participants.conversation_id
    AND we.user_id = conversation_participants.user_id
    AND we.status = 'enrolled'
  )
);

