-- This function is the main engine for awarding XP and checking badges.
-- It's designed to be called by other functions or triggers.
CREATE OR REPLACE FUNCTION award_xp_and_check_badges(
  p_user_id UUID,
  p_xp_to_award INT,
  p_action_type TEXT, -- e.g., 'lesson_completed', 'workshop_reviewed'
  p_workshop_id UUID DEFAULT NULL
)
RETURNS VOID
LANGUAGE plpgsql
SECURITY DEFINER -- Runs with elevated privileges, crucial for security
AS $$ DECLARE
  current_xp INT;
  new_level INT;
  new_total_xp INT;
  workshops_attended_count INT;
  workshops_taught_count INT;
  lesson_count INT;
BEGIN
  -- 1. Update user's total XP
  UPDATE users
  SET xp = xp + p_xp_to_award
  WHERE id = p_user_id
  RETURNING xp, level INTO new_total_xp, new_level;

  -- 2. Check for level up (simple logic: 500 XP per level)
  new_level := new_total_xp / 500 + 1;
  IF new_level > (SELECT level FROM users WHERE id = p_user_id) THEN
    UPDATE users SET level = new_level WHERE id = p_user_id;
  END IF;

  -- 3. Check and award badges based on the action

  -- Badge: First Steps (complete first lesson of any workshop)
  IF p_action_type = 'lesson_completed' THEN
    SELECT COUNT(*) INTO lesson_count
    FROM user_syllabus_progress
    WHERE user_id = p_user_id;

    IF lesson_count = 1 THEN
      UPDATE user_badges SET earned = TRUE, earned_at = NOW()
      WHERE user_id = p_user_id AND badge_id = (SELECT id FROM badge_definitions WHERE name = 'First Steps');
    END IF;
  END IF;

  -- Badge: Knowledge Seeker (complete lessons in 10 different workshops)
  SELECT COUNT(DISTINCT workshop_id) INTO workshops_attended_count
  FROM user_syllabus_progress
  WHERE user_id = p_user_id;

  IF workshops_attended_count >= 10 THEN
    UPDATE user_badges SET earned = TRUE, earned_at = NOW()
    WHERE user_id = p_user_id AND badge_id = (SELECT id FROM badge_definitions WHERE name = 'Knowledge Seeker');
  END IF;

  -- Badge: Rising Star (teach first workshop - awarded when creator marks a lesson for a student)
  IF p_action_type = 'lesson_completed' AND p_workshop_id IS NOT NULL THEN
    IF (SELECT creator_id FROM workshops WHERE id = p_workshop_id) = p_user_id THEN
       -- Check if this is the first time they are marking a lesson for any of their workshops
       IF (SELECT COUNT(*) FROM user_syllabus_progress usp JOIN workshops w ON usp.workshop_id = w.id WHERE w.creator_id = p_user_id AND usp.completed_at IS NOT NULL) = 1 THEN
          UPDATE user_badges SET earned = TRUE, earned_at = NOW()
          WHERE user_id = p_user_id AND badge_id = (SELECT id FROM badge_definitions WHERE name = 'Rising Star');
       END IF;
    END IF;
  END IF;

  -- You can add more badge logic here for other actions like submitting reviews, etc.

END;
 $$;







 -- Function to be called when a creator marks a lesson as complete for an enrolled user.
CREATE OR REPLACE FUNCTION mark_lesson_complete(
  p_user_id UUID,       -- The user who is being marked complete
  p_workshop_id UUID,
  p_lesson_index INT
)
RETURNS TABLE (success BOOLEAN, message TEXT)
LANGUAGE plpgsql
SECURITY DEFINER
AS $$ DECLARE
  is_enrolled BOOLEAN;
BEGIN
  -- Check if the user is actually enrolled in the workshop
  SELECT EXISTS(SELECT 1 FROM workshop_enrollments WHERE user_id = p_user_id AND workshop_id = p_workshop_id) INTO is_enrolled;

  IF NOT is_enrolled THEN
    RETURN QUERY SELECT FALSE, 'User is not enrolled in this workshop.';
    RETURN;
  END IF;

  -- Insert progress, but only if not already completed
  INSERT INTO user_syllabus_progress (user_id, workshop_id, lesson_index, completed_at)
  VALUES (p_user_id, p_workshop_id, p_lesson_index, NOW())
  ON CONFLICT (user_id, workshop_id, lesson_index) DO NOTHING;

  -- Check if a new row was inserted (i.e., it wasn't already completed)
  IF FOUND THEN
    -- Award XP and check badges for the STUDENT
    PERFORM award_xp_and_check_badges(p_user_id, 10, 'lesson_completed', p_workshop_id);

    -- Also award XP to the CREATOR for teaching
    PERFORM award_xp_and_check_badges((SELECT creator_id FROM workshops WHERE id = p_workshop_id), 5, 'lesson_taught', p_workshop_id);

    RETURN QUERY SELECT TRUE, 'Lesson marked as complete and XP awarded.';
  ELSE
    RETURN QUERY SELECT FALSE, 'Lesson was already marked as complete.';
  END IF;
END;
 $$;

