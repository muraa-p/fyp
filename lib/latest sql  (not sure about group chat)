-- Create a trigger to automatically create a group chat for non-Teach4Learn workshops
CREATE OR REPLACE FUNCTION auto_create_workshop_chat()
RETURNS TRIGGER AS $$
BEGIN
  IF NEW.type != 'Teach4Learn' THEN
    PERFORM create_workshop_group_chat(NEW.id, NEW.title, NEW.creator_id);
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER create_workshop_chat_trigger
AFTER INSERT ON workshops
FOR EACH ROW
EXECUTE FUNCTION auto_create_workshop_chat();

