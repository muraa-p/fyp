-- Helper function to check conversation participation
CREATE OR REPLACE FUNCTION is_conversation_participant(conv_id UUID, user_id UUID)
RETURNS BOOLEAN
LANGUAGE sql
SECURITY INVOKER
STABLE
AS $$   SELECT EXISTS (
    SELECT 1 FROM conversation_participants cp
    WHERE cp.conversation_id = conv_id AND cp.user_id = user_id
  );
 $$;

-- Check if a conversation exists between two users
CREATE OR REPLACE FUNCTION get_existing_conversation(user1_id UUID, user2_id UUID)
RETURNS TABLE(id UUID) AS $$ BEGIN
  RETURN QUERY
  SELECT c.id
  FROM conversations c
  JOIN conversation_participants cp1 ON c.id = cp1.conversation_id
  JOIN conversation_participants cp2 ON c.id = cp2.conversation_id
  WHERE cp1.user_id = user1_id
    AND cp2.user_id = user2_id
    AND c.is_group = FALSE
  LIMIT 1;
END;
 $$ LANGUAGE plpgsql SECURITY DEFINER;

-- Get all conversations for a user with details
CREATE OR REPLACE FUNCTION get_user_conversations(current_user_id UUID)
RETURNS TABLE(
  id UUID,
  is_group BOOLEAN,
  name TEXT,
  avatar_url TEXT,
  updated_at TIMESTAMPTZ,
  last_message_content TEXT,
  last_message_time TIMESTAMPTZ,
  last_message_sender_name TEXT,
  other_user JSON,
  unread_count BIGINT,
  workshop_id UUID
) LANGUAGE sql STABLE SECURITY DEFINER AS $$   SELECT
    c.id,
    c.is_group,
    c.name,
    c.avatar_url,
    c.updated_at,
    m.content AS last_message_content,
    m.created_at AS last_message_time,
    sender.name AS last_message_sender_name,
    jsonb_build_object(
      'id', u.id,
      'name', u.name,
      'avatar_url', u.avatar_url
    ) AS other_user,
    COUNT(msg.id) FILTER (WHERE msg.read_at IS NULL AND msg.sender_id != current_user_id)::BIGINT AS unread_count,
    w.id AS workshop_id
  FROM conversations c
  JOIN conversation_participants cp ON c.id = cp.conversation_id
  LEFT JOIN messages m ON m.id = c.last_message_id
  LEFT JOIN users sender ON sender.id = m.sender_id
  LEFT JOIN LATERAL (
    SELECT u.id, u.name, u.avatar_url
    FROM conversation_participants cp2
    JOIN users u ON u.id = cp2.user_id
    WHERE cp2.conversation_id = c.id AND cp2.user_id != current_user_id
    LIMIT 1
  ) u ON NOT c.is_group
  LEFT JOIN messages msg ON msg.conversation_id = c.id
    AND msg.sender_id != current_user_id
    AND msg.read_at IS NULL
  LEFT JOIN workshops w ON w.conversation_id = c.id
  WHERE cp.user_id = current_user_id
  GROUP BY c.id, c.is_group, c.name, c.avatar_url, c.updated_at,
           m.content, m.created_at, sender.name, u.id, u.name, u.avatar_url, w.id
  ORDER BY c.updated_at DESC NULLS LAST, m.created_at DESC NULLS LAST;
 $$;

-- Create a workshop group chat
CREATE OR REPLACE FUNCTION create_workshop_group_chat(
  workshop_id UUID,
  workshop_title TEXT,
  creator_id UUID
)
RETURNS UUID AS $$ DECLARE
  conversation_uuid UUID;
BEGIN
  INSERT INTO conversations (is_group, name, created_by)
  VALUES (TRUE, workshop_title || ' - Group Chat', creator_id)
  RETURNING id INTO conversation_uuid;

  INSERT INTO conversation_participants (conversation_id, user_id, is_admin)
  VALUES (conversation_uuid, creator_id, TRUE);

  UPDATE workshops
  SET conversation_id = conversation_uuid
  WHERE id = workshop_id;

  INSERT INTO messages (conversation_id, sender_id, content)
  VALUES (
    conversation_uuid,
    creator_id,
    'Welcome to the group chat for ' || workshop_title || '! This is where we''ll share updates, materials, and announcements.'
  );

  RETURN conversation_uuid;
END;
 $$ LANGUAGE plpgsql SECURITY DEFINER;

-- Add a user to a workshop group chat
CREATE OR REPLACE FUNCTION add_user_to_workshop_chat(
  workshop_id UUID,
  participant_id UUID
)
RETURNS VOID AS $$ DECLARE
  conv_id UUID;
BEGIN
  SELECT conversation_id INTO conv_id
  FROM workshops
  WHERE id = workshop_id;

  IF conv_id IS NOT NULL THEN
    INSERT INTO conversation_participants (conversation_id, user_id)
    VALUES (conv_id, participant_id)
    ON CONFLICT (conversation_id, user_id) DO NOTHING;
  END IF;
END;
 $$ LANGUAGE plpgsql SECURITY DEFINER;

-- Function to mark a lesson as complete
CREATE OR REPLACE FUNCTION mark_lesson_complete(
  p_user_id UUID,
  p_workshop_id UUID,
  p_lesson_index INT
)
RETURNS TABLE (success BOOLEAN, message TEXT)
LANGUAGE plpgsql
SECURITY DEFINER
AS $$ DECLARE
  is_enrolled BOOLEAN;
  total_lessons INT;
  completed_lessons INT;
BEGIN
  -- Check if the user is actually enrolled in the workshop
  SELECT EXISTS(SELECT 1 FROM workshop_enrollments WHERE user_id = p_user_id AND workshop_id = p_workshop_id) INTO is_enrolled;

  IF NOT is_enrolled THEN
    RETURN QUERY SELECT FALSE, 'User is not enrolled in this workshop.';
    RETURN;
  END IF;

  -- Insert progress, but only if not already completed
  INSERT INTO user_syllabus_progress (user_id, workshop_id, lesson_index, completed_at)
  VALUES (p_user_id, p_workshop_id, p_lesson_index, NOW())
  ON CONFLICT (user_id, workshop_id, lesson_index) DO NOTHING;

  -- Check if a new row was inserted (i.e., it wasn't already completed)
  IF FOUND THEN
    -- Award XP and check badges for the STUDENT
    PERFORM award_xp_and_check_badges(p_user_id, 10, 'lesson_completed', p_workshop_id);

    -- Also award XP to the CREATOR for teaching
    PERFORM award_xp_and_check_badges((SELECT creator_id FROM workshops WHERE id = p_workshop_id), 5, 'lesson_taught', p_workshop_id);

    -- Get workshop details for completion check
    SELECT jsonb_array_length(syllabus) INTO total_lessons
    FROM workshops
    WHERE id = p_workshop_id;

    -- Get the number of completed lessons for the user
    SELECT COUNT(*) INTO completed_lessons
    FROM user_syllabus_progress
    WHERE user_id = p_user_id AND workshop_id = p_workshop_id;

    -- Check if all lessons are completed
    IF total_lessons IS NOT NULL AND completed_lessons >= total_lessons THEN
      -- Mark the workshop as completed in the enrollments table
      UPDATE workshop_enrollments
      SET status = 'completed', completed_at = NOW()
      WHERE user_id = p_user_id AND workshop_id = p_workshop_id;

      -- Award XP and check for completion badges
      PERFORM award_xp_and_check_badges(p_user_id, 50, 'workshop_completed', p_workshop_id);

      RETURN QUERY SELECT TRUE, 'Lesson marked as complete and workshop completed! XP awarded.';
    ELSE
      RETURN QUERY SELECT TRUE, 'Lesson marked as complete and XP awarded.';
    END IF;
  ELSE
    RETURN QUERY SELECT FALSE, 'Lesson was already marked as complete.';
  END IF;
END;
 $$;

-- Function to award XP and check badges
CREATE OR REPLACE FUNCTION award_xp_and_check_badges(
  p_user_id UUID,
  p_xp_to_award INT,
  p_action_type TEXT,
  p_workshop_id UUID DEFAULT NULL
)
RETURNS VOID
LANGUAGE plpgsql
SECURITY DEFINER
AS $$ DECLARE
  new_total_xp INT;
  new_level INT;
  workshops_attended_count INT;
  workshops_completed_count INT;
  lesson_count INT;
  current_badge_id UUID;
BEGIN
  -- 1. Update user's total XP
  UPDATE users
  SET xp = xp + p_xp_to_award
  WHERE id = p_user_id
  RETURNING xp INTO new_total_xp;

  -- 2. Check for level up (simple logic: 500 XP per level)
  new_level := new_total_xp / 500 + 1;
  IF new_level > (SELECT level FROM users WHERE id = p_user_id) THEN
    UPDATE users SET level = new_level WHERE id = p_user_id;
  END IF;

  -- 3. Check and award badges based on the action

  -- Badge: First Steps (complete first lesson of any workshop)
  IF p_action_type = 'lesson_completed' THEN
    SELECT COUNT(*) INTO lesson_count
    FROM user_syllabus_progress
    WHERE user_id = p_user_id;

    -- Update progress for First Steps badge
    SELECT id INTO current_badge_id FROM badge_definitions WHERE name = 'First Steps';
    IF current_badge_id IS NOT NULL THEN
      INSERT INTO user_badges (user_id, badge_id, progress, earned)
      VALUES (p_user_id, current_badge_id, LEAST(lesson_count, 1), lesson_count >= 1)
      ON CONFLICT (user_id, badge_id)
      DO UPDATE SET
        progress = LEAST(lesson_count, 1),
        earned = EXCLUDED.progress >= 1 AND user_badges.earned = FALSE,
        earned_at = CASE WHEN EXCLUDED.progress >= 1 AND user_badges.earned = FALSE THEN NOW() ELSE user_badges.earned_at END;
    END IF;
  END IF;

  -- Badge: Knowledge Seeker (complete lessons in 10 different workshops)
  SELECT COUNT(DISTINCT workshop_id) INTO workshops_attended_count
  FROM user_syllabus_progress
  WHERE user_id = p_user_id;

  -- Update progress for Knowledge Seeker badge
  SELECT id INTO current_badge_id FROM badge_definitions WHERE name = 'Knowledge Seeker';
  IF current_badge_id IS NOT NULL THEN
    INSERT INTO user_badges (user_id, badge_id, progress, earned)
    VALUES (p_user_id, current_badge_id, workshops_attended_count, workshops_attended_count >= 10)
    ON CONFLICT (user_id, badge_id)
    DO UPDATE SET
      progress = EXCLUDED.progress,
      earned = EXCLUDED.progress >= 10 AND user_badges.earned = FALSE,
      earned_at = CASE WHEN EXCLUDED.progress >= 10 AND user_badges.earned = FALSE THEN NOW() ELSE user_badges.earned_at END;
  END IF;

  -- Badge: Workshop Graduate (complete first workshop)
  IF p_action_type IN ('workshop_completed', 'workshop_deadline_completed') THEN
    SELECT COUNT(*) INTO workshops_completed_count
    FROM workshop_enrollments
    WHERE user_id = p_user_id AND status = 'completed';

    -- Update progress for Workshop Graduate badge
    SELECT id INTO current_badge_id FROM badge_definitions WHERE name = 'Workshop Graduate';
    IF current_badge_id IS NOT NULL THEN
      INSERT INTO user_badges (user_id, badge_id, progress, earned)
      VALUES (p_user_id, current_badge_id, workshops_completed_count, workshops_completed_count >= 1)
      ON CONFLICT (user_id, badge_id)
      DO UPDATE SET
        progress = EXCLUDED.progress,
        earned = EXCLUDED.progress >= 1 AND user_badges.earned = FALSE,
        earned_at = CASE WHEN EXCLUDED.progress >= 1 AND user_badges.earned = FALSE THEN NOW() ELSE user_badges.earned_at END;
    END IF;
  END IF;

  -- Badge: Dedicated Learner (complete 5 workshops)
  IF p_action_type IN ('workshop_completed', 'workshop_deadline_completed') THEN
    SELECT COUNT(*) INTO workshops_completed_count
    FROM workshop_enrollments
    WHERE user_id = p_user_id AND status = 'completed';

    -- Update progress for Dedicated Learner badge
    SELECT id INTO current_badge_id FROM badge_definitions WHERE name = 'Dedicated Learner';
    IF current_badge_id IS NOT NULL THEN
      INSERT INTO user_badges (user_id, badge_id, progress, earned)
      VALUES (p_user_id, current_badge_id, workshops_completed_count, workshops_completed_count >= 5)
      ON CONFLICT (user_id, badge_id)
      DO UPDATE SET
        progress = EXCLUDED.progress,
        earned = EXCLUDED.progress >= 5 AND user_badges.earned = FALSE,
        earned_at = CASE WHEN EXCLUDED.progress >= 5 AND user_badges.earned = FALSE THEN NOW() ELSE user_badges.earned_at END;
    END IF;
  END IF;

  -- Badge: Rising Star (teach first workshop)
  IF p_action_type = 'lesson_completed' AND p_workshop_id IS NOT NULL THEN
    IF (SELECT creator_id FROM workshops WHERE id = p_workshop_id) = p_user_id THEN
       -- Check if this is the first time they are marking a lesson for any of their workshops
       IF (SELECT COUNT(*) FROM user_syllabus_progress usp JOIN workshops w ON usp.workshop_id = w.id WHERE w.creator_id = p_user_id AND usp.completed_at IS NOT NULL) = 1 THEN
          -- Update progress for Rising Star badge
          SELECT id INTO current_badge_id FROM badge_definitions WHERE name = 'Rising Star';
          IF current_badge_id IS NOT NULL THEN
            INSERT INTO user_badges (user_id, badge_id, progress, earned)
            VALUES (p_user_id, current_badge_id, 1, true)
            ON CONFLICT (user_id, badge_id)
            DO UPDATE SET
              progress = 1,
              earned = true,
              earned_at = CASE WHEN user_badges.earned = FALSE THEN NOW() ELSE user_badges.earned_at END;
          END IF;
       END IF;
    END IF;
  END IF;
END;
 $$;

-- Function to get all user gamification data
CREATE OR REPLACE FUNCTION get_user_gamification_data(current_user_id UUID)
RETURNS TABLE(
  user_xp INT,
  user_level INT,
  workshops_attended BIGINT,
  workshops_taught BIGINT,
  badges_earned BIGINT,
  endorsements_count BIGINT,
  leaderboard JSONB,
  user_badges_data JSONB,
  user_achievements_data JSONB
) LANGUAGE sql STABLE SECURITY DEFINER AS $$   SELECT
    -- User Stats
    u.xp,
    u.level,
    (SELECT count(*) FROM workshop_enrollments WHERE user_id = current_user_id),
    (SELECT count(*) FROM workshops WHERE creator_id = current_user_id),
    (SELECT count(*) FROM user_badges WHERE user_id = current_user_id AND earned = true),
    (SELECT count(*) FROM endorsements WHERE endorsed_user = current_user_id),

    -- Leaderboard (Top 20)
    (SELECT jsonb_agg(row_to_json(lb))
     FROM (
       SELECT
         row_number() OVER (ORDER BY xp DESC) AS rank,
         id,
         name,
         avatar_url,
         xp,
         (SELECT count(*) FROM user_badges WHERE user_id = u.id AND earned = true) AS badges
       FROM users u
       ORDER BY xp DESC
       LIMIT 20
     ) AS lb
    ),

    -- User Badges (merged with definitions)
    (SELECT jsonb_agg(row_to_json(badge_data))
     FROM (
       SELECT
         bd.id,
         bd.name,
         bd.description,
         bd.icon,
         bd.rarity,
         COALESCE(ub.earned, false) AS earned,
         COALESCE(ub.progress, 0) AS progress,
         bd.requirement_value AS max,
         ub.earned_at
       FROM badge_definitions bd
       LEFT JOIN user_badges ub ON bd.id = ub.badge_id AND ub.user_id = current_user_id
     ) AS badge_data
    ),

    -- User Achievements (merged with definitions)
    (SELECT jsonb_agg(row_to_json(ach_data))
     FROM (
       SELECT
         ad.id,
         ad.title,
         ad.description,
         ad.icon,
         ad.reward_value AS reward,
         COALESCE(ua.progress, 0) AS progress,
         ad.requirement_value AS max
       FROM achievement_definitions ad
       LEFT JOIN user_achievements ua ON ad.id = ua.achievement_id AND ua.user_id = current_user_id
     ) AS ach_data
    )

  FROM users u WHERE u.id = current_user_id;
 $$;

