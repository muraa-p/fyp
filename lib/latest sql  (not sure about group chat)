-- Core user table
CREATE TABLE users (
  id UUID PRIMARY KEY,                     -- Supabase Auth user ID
  email TEXT UNIQUE NOT NULL,
  name TEXT,
  phone TEXT,
  bio TEXT,
  university TEXT,
  major TEXT,
  year TEXT,
  location TEXT,
  website TEXT,
  avatar_url TEXT,
  skills_to_teach TEXT[],
  skills_to_learn TEXT[],
  social JSONB DEFAULT '{}'::JSONB,
  xp INTEGER DEFAULT 0,
  level INTEGER DEFAULT 1,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Skills reference table
CREATE TABLE skills (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  name TEXT UNIQUE NOT NULL
);

-- Social connections
CREATE TABLE follows (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  follower_id UUID REFERENCES users(id) ON DELETE CASCADE,
  following_id UUID REFERENCES users(id) ON DELETE CASCADE,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE(follower_id, following_id)
);

-- Conversation tables (create base tables first)
CREATE TABLE conversations (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  is_group BOOLEAN DEFAULT FALSE,
  name TEXT,
  avatar_url TEXT,
  created_by UUID REFERENCES users(id) ON DELETE CASCADE
  -- last_message_id will be added later after messages table exists
);

CREATE TABLE messages (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  conversation_id UUID REFERENCES conversations(id) ON DELETE CASCADE,
  sender_id UUID REFERENCES users(id) ON DELETE CASCADE,
  content TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  read_at TIMESTAMPTZ,
  message_type TEXT DEFAULT 'text'
);

CREATE TABLE conversation_participants (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  conversation_id UUID REFERENCES conversations(id) ON DELETE CASCADE,
  user_id UUID REFERENCES users(id) ON DELETE CASCADE,
  joined_at TIMESTAMPTZ DEFAULT NOW(),
  last_read_at TIMESTAMPTZ,
  is_admin BOOLEAN DEFAULT FALSE,
  UNIQUE(conversation_id, user_id)
);

-- Now add the foreign key to conversations table
ALTER TABLE conversations
ADD COLUMN last_message_id UUID REFERENCES messages(id) ON DELETE SET NULL;

-- Workshop tables
CREATE TABLE workshops (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  creator_id UUID REFERENCES users(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  description TEXT,
  category TEXT,
  duration TEXT,
  date TIMESTAMPTZ,
  max_participants INTEGER,
  skills TEXT[],
  image_url TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  type TEXT DEFAULT 'Free Workshop',
  skill_requested TEXT,
  skill_offered TEXT,
  difficulty TEXT DEFAULT 'Beginner',
  time TEXT,
  location TEXT,
  status TEXT DEFAULT 'upcoming',
  workshop_status TEXT DEFAULT 'upcoming' CHECK (workshop_status IN ('upcoming', 'in_progress', 'finished', 'cancelled')),
  rating FLOAT DEFAULT 0.0,
  syllabus JSONB DEFAULT '[]'::JSONB,
  prerequisites TEXT[] DEFAULT '{}',
  outcomes TEXT[] DEFAULT '{}',
  tags TEXT[] DEFAULT '{}'
  -- conversation_id will be added later
);

-- Add conversation_id after workshops table exists
ALTER TABLE workshops
ADD COLUMN conversation_id UUID REFERENCES conversations(id) ON DELETE SET NULL;

CREATE TABLE workshop_enrollments (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id UUID REFERENCES users(id) ON DELETE CASCADE,
  workshop_id UUID REFERENCES workshops(id) ON DELETE CASCADE,
  status TEXT DEFAULT 'enrolled',
  enrolled_at TIMESTAMPTZ DEFAULT NOW(),
  completed_at TIMESTAMPTZ,
  UNIQUE(user_id, workshop_id)
);

CREATE TABLE workshop_ratings (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  workshop_id UUID REFERENCES workshops(id) ON DELETE CASCADE,
  user_id UUID REFERENCES users(id) ON DELETE CASCADE,
  rating INTEGER CHECK(rating >= 1 AND rating <= 5),
  review TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE(user_id, workshop_id)
);

CREATE TABLE workshop_requests (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  workshop_id UUID REFERENCES workshops(id) ON DELETE CASCADE,
  requester_id UUID REFERENCES users(id) ON DELETE CASCADE,
  status TEXT DEFAULT 'pending',
  message TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE(workshop_id, requester_id)
);

-- User achievement tables
CREATE TABLE endorsements (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  endorsed_user UUID REFERENCES users(id),
