import { serve } from "https://deno.land/std@0.168.0/http/server.ts"

const RESEND_API_KEY = Deno.env.get("RESEND_API_KEY")

serve(async (req) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { status: 200 })
  }

  try {
    const { to, link } = await req.json()

    if (!to || !link) {
      return new Response(JSON.stringify({ error: "Missing to or link" }), {
        status: 400,
        headers: { "Content-Type": "application/json" },
      })
    }

    const res = await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${RESEND_API_KEY}`,
      },
      body: JSON.stringify({
        from: "SkillX <onboarding@resend.dev>",  // Change to your verified domain/email
        to: [to],
        subject: "Delete Your SkillX Account",
        html: `
          <h2>Account Deletion Request</h2>
          <p>You requested to delete your SkillX account.</p>
          <p>Click the link below to confirm deletion (valid for 3 days):</p>
          <p><a href="${link}" style="padding: 12px 20px; background: #dc2626; color: white; text-decoration: none; border-radius: 6px;">Delete My Account</a></p>
          <p>If you didn't request this, ignore this email.</p>
        `,
        text: `Click this link to delete your account: ${link}`,
      }),
    })

    const data = await res.json()

    if (!res.ok) {
      console.error("Resend error:", data)
      return new Response(JSON.stringify({ error: "Failed to send email" }), {
        status: 500,
      })
    }

    return new Response(JSON.stringify({ success: true, data }), {
      status: 200,
      headers: { "Content-Type": "application/json" },
    })
  } catch (error) {
    console.error("Function error:", error)
    return new Response(JSON.stringify({ error: error.message }), { status: 500 })
  }
})