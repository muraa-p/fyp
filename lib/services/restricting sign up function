SELECT * FROM signup_email_domains;

-- 2. Ultra-robust hook function (handles ALL possible event structures + logging)
CREATE OR REPLACE FUNCTION public.hook_restrict_signup_by_email_domain(event jsonb)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  raw_email TEXT := '';
  email_domain TEXT := '';
  allowed BOOLEAN := false;
BEGIN
  -- Log the full event for debugging (visible in Supabase logs)
  RAISE LOG '=== SIGNUP HOOK CALLED === Event: %', event::text;

  -- Extract email from EVERY possible location Supabase might put it
  raw_email := COALESCE(
    event->>'email',
    event->'user'->>'email',
    event->'data'->>'email',
    event->'data'->'user'->>'email',
    event->'request'->'user'->>'email',
    (event->'user_attributes'->>'email')
  );

  IF raw_email IS NULL OR raw_email = '' THEN
    RAISE LOG 'Signup hook: No email found in any field';
    RETURN '{}'::jsonb;  -- Fail open — don't block if we can't check
  END IF;

  email_domain := lower(trim(split_part(raw_email, '@', 2)));

  RAISE LOG 'Signup hook: Extracted email=%, domain=%', raw_email, email_domain;

  -- Check allowed domains
  SELECT EXISTS(
    SELECT 1 FROM signup_email_domains
    WHERE lower(domain) = email_domain
  ) INTO allowed;

  RAISE LOG 'Signup hook: Domain allowed = %', allowed;

  IF allowed THEN
    RETURN '{}'::jsonb;  -- Allow
  ELSE
    RETURN jsonb_build_object(
      'error', jsonb_build_object(
        'http_code', 400,
        'message', 'Only university emails (@mail.apu.edu.my) are allowed to sign up.'
      )
    );
  END IF;

EXCEPTION WHEN OTHERS THEN
  RAISE LOG 'Signup hook EXCEPTION: % %', SQLERRM, SQLSTATE;
  RETURN '{}'::jsonb;  -- Never crash — fail open
END;
$$;

-- 3. Permissions (run again to be 100% sure)
GRANT USAGE ON SCHEMA public TO supabase_auth_admin;
GRANT SELECT ON TABLE public.signup_email_domains TO supabase_auth_admin;
GRANT EXECUTE ON FUNCTION public.hook_restrict_signup_by_email_domain(jsonb) TO supabase_auth_admin;
GRANT EXECUTE ON FUNCTION public.hook_restrict_signup_by_email_domain(jsonb) TO PUBLIC;