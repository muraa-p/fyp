-- 2. UPDATED: award_xp_and_check_badges
-- Adds support for 'workshop_taught_successfully' action type
-- Removes broken old Rising Star logic
CREATE OR REPLACE FUNCTION award_xp_and_check_badges(
  p_user_id UUID,
  p_xp_to_award INT,
  p_action_type TEXT,
  p_workshop_id UUID DEFAULT NULL
)
RETURNS VOID
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  new_total_xp INT;
  new_level INT;
  workshops_attended_count BIGINT;
  workshops_completed_count INT;
  workshops_taught_count BIGINT;  -- NEW
  lesson_count BIGINT;
BEGIN
  -- Award XP and update level
  UPDATE users SET xp = xp + p_xp_to_award
  WHERE id = p_user_id RETURNING xp INTO new_total_xp;

  new_level := new_total_xp / 500 + 1;
  IF new_level > (SELECT level FROM users WHERE id = p_user_id) THEN
    UPDATE users SET level = new_level WHERE id = p_user_id;
  END IF;

  -- Learner badges
  IF p_action_type = 'lesson_completed' THEN
    SELECT COUNT(*) INTO lesson_count FROM user_syllabus_progress WHERE user_id = p_user_id;
    PERFORM update_badge_and_notify(p_user_id, 'First Steps', lesson_count, 1);

    SELECT COUNT(DISTINCT workshop_id) INTO workshops_attended_count
    FROM user_syllabus_progress WHERE user_id = p_user_id;
    PERFORM update_badge_and_notify(p_user_id, 'Knowledge Seeker', workshops_attended_count, 10);
  END IF;

  IF p_action_type IN ('workshop_completed', 'workshop_deadline_completed', 'workshop_reviewed') THEN
    SELECT COUNT(*) INTO workshops_completed_count
    FROM workshop_enrollments WHERE user_id = p_user_id AND status = 'completed';

    PERFORM update_badge_and_notify(p_user_id, 'Workshop Graduate', workshops_completed_count, 1);
    PERFORM update_badge_and_notify(p_user_id, 'Dedicated Learner', workshops_completed_count, 5);

    IF p_action_type IN ('workshop_completed', 'workshop_deadline_completed') THEN
      PERFORM update_monthly_achievement_progress(p_user_id, 'monthly_workshop_attendance');
    END IF;
  END IF;

  -- === NEW: Creator badges when someone completes their workshop ===
  IF p_action_type = 'workshop_taught_successfully' THEN
    SELECT COUNT(DISTINCT we.workshop_id) INTO workshops_taught_count
    FROM workshop_enrollments we
    WHERE we.status = 'completed'
      AND we.workshop_id IN (SELECT id FROM workshops WHERE creator_id = p_user_id);

    PERFORM update_badge_and_notify(p_user_id, 'Rising Star', workshops_taught_count, 1);
    PERFORM update_badge_and_notify(p_user_id, 'Community Leader', workshops_taught_count, 10);
    PERFORM update_badge_and_notify(p_user_id, 'Legendary Mentor', workshops_taught_count, 50);
  END IF;
  -- ==================================================================

  -- REMOVED: Old broken Rising Star check that only triggered if creator completed their own lesson
END;
$$;

