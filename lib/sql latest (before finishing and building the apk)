CREATE OR REPLACE FUNCTION update_badge_and_notify(
  p_user_id UUID,
  p_badge_name TEXT,
  p_progress BIGINT,
  p_required INTEGER
)
RETURNS VOID
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  v_badge_id UUID;
  previously_earned BOOLEAN := FALSE;
  newly_earned BOOLEAN;
BEGIN
  SELECT id INTO v_badge_id FROM badge_definitions WHERE name = p_badge_name;
  IF v_badge_id IS NULL THEN RETURN; END IF;

  SELECT earned INTO previously_earned
  FROM user_badges
  WHERE user_id = p_user_id AND badge_id = v_badge_id;
  previously_earned := COALESCE(previously_earned, FALSE);

  INSERT INTO user_badges (user_id, badge_id, progress, earned, earned_at)
  VALUES (p_user_id, v_badge_id, p_progress, p_progress >= p_required,
          CASE WHEN p_progress >= p_required THEN NOW() ELSE NULL END)
  ON CONFLICT (user_id, badge_id) DO UPDATE SET
    progress = EXCLUDED.progress,
    earned = EXCLUDED.earned,
    earned_at = CASE WHEN EXCLUDED.earned AND NOT user_badges.earned THEN NOW() ELSE user_badges.earned_at END;

  newly_earned := (p_progress >= p_required) AND NOT previously_earned;

  IF newly_earned THEN
    INSERT INTO notifications (user_id, title, body, type, data)
    VALUES (p_user_id, 'Badge Earned! 🎉', 'You earned the "' || p_badge_name || '" badge!', 'badge',
            jsonb_build_object('badge_id', v_badge_id));
  END IF;
END;
$$;

CREATE OR REPLACE FUNCTION award_xp_and_check_badges(
  p_user_id UUID,
  p_xp_to_award INT,
  p_action_type TEXT,
  p_workshop_id UUID DEFAULT NULL
)
RETURNS VOID
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  new_total_xp INT;
  new_level INT;
  workshops_attended_count BIGINT;
  workshops_completed_count INT;
  lesson_count BIGINT;
BEGIN
  UPDATE users SET xp = xp + p_xp_to_award
  WHERE id = p_user_id RETURNING xp INTO new_total_xp;

  new_level := new_total_xp / 500 + 1;
  IF new_level > (SELECT level FROM users WHERE id = p_user_id) THEN
    UPDATE users SET level = new_level WHERE id = p_user_id;
  END IF;

  IF p_action_type = 'lesson_completed' THEN
    SELECT COUNT(*) INTO lesson_count FROM user_syllabus_progress WHERE user_id = p_user_id;
    PERFORM update_badge_and_notify(p_user_id, 'First Steps', lesson_count, 1);

    SELECT COUNT(DISTINCT workshop_id) INTO workshops_attended_count
    FROM user_syllabus_progress WHERE user_id = p_user_id;
    PERFORM update_badge_and_notify(p_user_id, 'Knowledge Seeker', workshops_attended_count, 10);
  END IF;

  IF p_action_type IN ('workshop_completed', 'workshop_deadline_completed', 'workshop_reviewed') THEN
    SELECT COUNT(*) INTO workshops_completed_count
    FROM workshop_enrollments WHERE user_id = p_user_id AND status = 'completed';

    PERFORM update_badge_and_notify(p_user_id, 'Workshop Graduate', workshops_completed_count, 1);
    PERFORM update_badge_and_notify(p_user_id, 'Dedicated Learner', workshops_completed_count, 5);

    IF p_action_type IN ('workshop_completed', 'workshop_deadline_completed') THEN
      PERFORM update_monthly_achievement_progress(p_user_id, 'monthly_workshop_attendance');
    END IF;
  END IF;

  IF p_action_type = 'lesson_completed' AND p_workshop_id IS NOT NULL THEN
    IF (SELECT creator_id FROM workshops WHERE id = p_workshop_id) = p_user_id THEN
      IF (SELECT COUNT(*) FROM user_syllabus_progress usp
          JOIN workshops w ON usp.workshop_id = w.id
          WHERE w.creator_id = p_user_id AND usp.completed_at IS NOT NULL) = 1 THEN
        PERFORM update_badge_and_notify(p_user_id, 'Rising Star', 1, 1);
      END IF;
    END IF;
  END IF;
END;
$$;

CREATE OR REPLACE FUNCTION is_conversation_participant(conv_id UUID, user_id UUID)
RETURNS BOOLEAN LANGUAGE sql SECURITY INVOKER STABLE
AS $$ SELECT EXISTS (SELECT 1 FROM conversation_participants cp WHERE cp.conversation_id = conv_id AND cp.user_id = user_id); $$;

CREATE OR REPLACE FUNCTION get_existing_conversation(user1_id UUID, user2_id UUID)
RETURNS TABLE(id UUID) LANGUAGE plpgsql SECURITY DEFINER AS $$
BEGIN
  RETURN QUERY
  SELECT c.id FROM conversations c
  JOIN conversation_participants cp1 ON c.id = cp1.conversation_id
  JOIN conversation_participants cp2 ON c.id = cp2.conversation_id
  WHERE cp1.user_id = user1_id AND cp2.user_id = user2_id AND c.is_group = FALSE
  LIMIT 1;
END;
$$;

CREATE OR REPLACE FUNCTION get_user_conversations(current_user_id UUID)
RETURNS TABLE(
  id UUID, is_group BOOLEAN, name TEXT, avatar_url TEXT, updated_at TIMESTAMPTZ,
  last_message_content TEXT, last_message_time TIMESTAMPTZ, last_message_sender_name TEXT,
  other_user JSON, unread_count BIGINT, workshop_id UUID
) LANGUAGE sql STABLE SECURITY DEFINER AS $$
  SELECT
    c.id, c.is_group, c.name, c.avatar_url, c.updated_at,
    m.content AS last_message_content, m.created_at AS last_message_time, sender.name AS last_message_sender_name,
    jsonb_build_object('id', u.id, 'name', u.name, 'avatar_url', u.avatar_url) AS other_user,
    COUNT(msg.id) FILTER (WHERE msg.read_at IS NULL AND msg.sender_id != current_user_id)::BIGINT AS unread_count,
    w.id AS workshop_id
  FROM conversations c
  JOIN conversation_participants cp ON c.id = cp.conversation_id
  LEFT JOIN messages m ON m.id = c.last_message_id
  LEFT JOIN users sender ON sender.id = m.sender_id
  LEFT JOIN LATERAL (
    SELECT u.id, u.name, u.avatar_url
    FROM conversation_participants cp2 JOIN users u ON u.id = cp2.user_id
    WHERE cp2.conversation_id = c.id AND cp2.user_id != current_user_id LIMIT 1
  ) u ON NOT c.is_group
  LEFT JOIN messages msg ON msg.conversation_id = c.id AND msg.sender_id != current_user_id AND msg.read_at IS NULL
  LEFT JOIN workshops w ON w.conversation_id = c.id
  WHERE cp.user_id = current_user_id
  GROUP BY c.id, c.is_group, c.name, c.avatar_url, c.updated_at, m.content, m.created_at, sender.name, u.id, u.name, u.avatar_url, w.id
  ORDER BY c.updated_at DESC NULLS LAST, m.created_at DESC NULLS LAST;
$$;

CREATE OR REPLACE FUNCTION create_workshop_group_chat(workshop_id UUID, workshop_title TEXT, creator_id UUID)
RETURNS UUID LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE conversation_uuid UUID;
BEGIN
  INSERT INTO conversations (is_group, name, created_by)
  VALUES (TRUE, workshop_title || ' - Group Chat', creator_id)
  RETURNING id INTO conversation_uuid;

  INSERT INTO conversation_participants (conversation_id, user_id, is_admin)
  VALUES (conversation_uuid, creator_id, TRUE);

  UPDATE workshops SET conversation_id = conversation_uuid WHERE id = workshop_id;

  INSERT INTO messages (conversation_id, sender_id, content)
  VALUES (conversation_uuid, creator_id,
    'Welcome to the group chat for ' || workshop_title || '! This is where we''ll share updates, materials, and announcements.');

  RETURN conversation_uuid;
END;
$$;

CREATE OR REPLACE FUNCTION add_user_to_workshop_chat(workshop_id UUID, participant_id UUID)
RETURNS VOID LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE conv_id UUID;
BEGIN
  SELECT conversation_id INTO conv_id FROM workshops WHERE id = workshop_id;
  IF conv_id IS NOT NULL THEN
    INSERT INTO conversation_participants (conversation_id, user_id)
    VALUES (conv_id, participant_id)
    ON CONFLICT (conversation_id, user_id) DO NOTHING;
  END IF;
END;
$$;

CREATE OR REPLACE FUNCTION mark_lesson_complete(p_user_id UUID, p_workshop_id UUID, p_lesson_index INT)
RETURNS TABLE(success BOOLEAN, message TEXT) LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE
  is_enrolled BOOLEAN;
  total_lessons INT;
  completed_lessons INT;
  row_count INT;
BEGIN
  SELECT EXISTS(SELECT 1 FROM workshop_enrollments WHERE user_id = p_user_id AND workshop_id = p_workshop_id) INTO is_enrolled;
  IF NOT is_enrolled THEN RETURN QUERY SELECT FALSE, 'User is not enrolled in this workshop.'; RETURN; END IF;

  INSERT INTO user_syllabus_progress (user_id, workshop_id, lesson_index, completed_at)
  VALUES (p_user_id, p_workshop_id, p_lesson_index, NOW())
  ON CONFLICT (user_id, workshop_id, lesson_index) DO NOTHING;

  GET DIAGNOSTICS row_count = ROW_COUNT;

  IF row_count > 0 THEN
    PERFORM award_xp_and_check_badges(p_user_id, 10, 'lesson_completed', p_workshop_id);
    PERFORM award_xp_and_check_badges((SELECT creator_id FROM workshops WHERE id = p_workshop_id), 5, 'lesson_taught', p_workshop_id);

    SELECT jsonb_array_length(syllabus) INTO total_lessons FROM workshops WHERE id = p_workshop_id;
    SELECT COUNT(*) INTO completed_lessons FROM user_syllabus_progress WHERE user_id = p_user_id AND workshop_id = p_workshop_id;

    IF total_lessons IS NOT NULL AND completed_lessons >= total_lessons THEN
      UPDATE workshop_enrollments SET status = 'completed', completed_at = NOW()
      WHERE user_id = p_user_id AND workshop_id = p_workshop_id;
      PERFORM award_xp_and_check_badges(p_user_id, 50, 'workshop_completed', p_workshop_id);
      RETURN QUERY SELECT TRUE, 'Lesson marked as complete and workshop completed! XP awarded.';
    ELSE
      RETURN QUERY SELECT TRUE, 'Lesson marked as complete and XP awarded.';
    END IF;
  ELSE
    RETURN QUERY SELECT FALSE, 'Lesson was already marked as complete.';
  END IF;
END;
$$;

CREATE OR REPLACE FUNCTION get_user_gamification_data(current_user_id UUID)
RETURNS TABLE(
  user_xp INT, user_level INT, workshops_attended BIGINT, workshops_taught BIGINT,
  badges_earned BIGINT, endorsements_count BIGINT, leaderboard JSONB,
  user_badges_data JSONB, user_achievements_data JSONB
) LANGUAGE sql STABLE SECURITY DEFINER AS $$
  SELECT
    u.xp, u.level,
    (SELECT count(*) FROM workshop_enrollments WHERE user_id = current_user_id),
    (SELECT count(*) FROM workshops WHERE creator_id = current_user_id),
    (SELECT count(*) FROM user_badges WHERE user_id = current_user_id AND earned = true),
    (SELECT count(*) FROM endorsements WHERE endorsed_user = current_user_id),
    (SELECT jsonb_agg(row_to_json(lb)) FROM (
      SELECT row_number() OVER (ORDER BY xp DESC) AS rank, id, name, avatar_url, xp,
             (SELECT count(*) FROM user_badges WHERE user_id = u.id AND earned = true) AS badges
      FROM users u ORDER BY xp DESC LIMIT 20
    ) lb),
    (SELECT jsonb_agg(row_to_json(badge_data)) FROM (
      SELECT bd.id, bd.name, bd.description, bd.icon, bd.rarity,
             COALESCE(ub.earned, false) AS earned, COALESCE(ub.progress, 0) AS progress,
             bd.requirement_value AS max, ub.earned_at
      FROM badge_definitions bd
      LEFT JOIN user_badges ub ON bd.id = ub.badge_id AND ub.user_id = current_user_id
    ) badge_data),
    (SELECT jsonb_agg(row_to_json(ach_data)) FROM (
      SELECT ad.id, ad.title, ad.description, ad.icon, ad.reward_value AS reward,
             COALESCE(ua.progress, 0) AS progress, ad.requirement_value AS max
      FROM achievement_definitions ad
      LEFT JOIN user_achievements ua ON ad.id = ua.achievement_id AND ua.user_id = current_user_id
    ) ach_data)
  FROM users u WHERE u.id = current_user_id;
$$;

CREATE OR REPLACE FUNCTION auto_create_workshop_chat()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
  IF NEW.type != 'Teach4Learn' THEN
    PERFORM create_workshop_group_chat(NEW.id, NEW.title, NEW.creator_id);
  END IF;
  RETURN NEW;
END;
$$;

CREATE OR REPLACE FUNCTION check_workshop_completion(p_user_id UUID, p_workshop_id UUID)
RETURNS BOOLEAN LANGUAGE plpgsql SECURITY DEFINER AS $$
DECLARE
  total_lessons INT;
  completed_lessons INT;
  is_enrolled BOOLEAN;
BEGIN
  SELECT EXISTS(SELECT 1 FROM workshop_enrollments WHERE user_id = p_user_id AND workshop_id = p_workshop_id) INTO is_enrolled;
  IF NOT is_enrolled THEN RETURN FALSE; END IF;

  SELECT jsonb_array_length(syllabus) INTO total_lessons FROM workshops WHERE id = p_workshop_id;
  SELECT COUNT(*) INTO completed_lessons FROM user_syllabus_progress WHERE user_id = p_user_id AND workshop_id = p_workshop_id;

  IF total_lessons IS NOT NULL AND completed_lessons >= total_lessons THEN
    UPDATE workshop_enrollments SET status = 'completed', completed_at = NOW()
    WHERE user_id = p_user_id AND workshop_id = p_workshop_id AND status != 'completed';
    PERFORM award_xp_and_check_badges(p_user_id, 50, 'workshop_completed', p_workshop_id);
    RETURN TRUE;
  END IF;
  RETURN FALSE;
END;
$$;

CREATE OR REPLACE FUNCTION update_monthly_achievement_progress(p_user_id UUID, p_requirement_type TEXT)
